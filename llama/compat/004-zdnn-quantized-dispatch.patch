From: Justin Veltri <justin@ibm.com>
Subject: [PATCH] ggml-zdnn: add dequantize-then-dispatch for quantized MUL_MAT

Enables the zDNN/zAIU co-processor for quantized inference workloads by
dequantizing weight tensors (Q4_K_M, Q8_0, etc.) to F16 at model load
time, then dispatching MUL_MAT to zdnn_matmul_transpose_op().

Prior to this patch, supports_op() rejected all quantized weight types,
so the zAIU sat idle during all typical Ollama inference (Q4_K_M models).

Strategy:
- Weights (src0, constant): dequantize Q* → F32 → F16 once at init_tensor
  time, stickify the F16 result into the ztensor. Zero per-inference cost.
- Inputs (src1, F32 activations): stickify F32 per inference call as before.
- supports_op() is expanded to accept all quantized types that have a
  to_float trait (i.e. all types ggml knows how to dequantize).

Tested on: IBM LinuxONE Emperor 5 (Type 9175 / z17), granite3.3:2b Q4_K_M
---
 ggml/src/ggml-zdnn/utils.hpp     |  5 +++
 ggml/src/ggml-zdnn/utils.cpp     | 43 +++++++++++++++++++++
 ggml/src/ggml-zdnn/ggml-zdnn.cpp | 65 ++++++++++++++++++++-----------
 3 files changed, 89 insertions(+), 24 deletions(-)

diff --git a/ggml/src/ggml-zdnn/utils.hpp b/ggml/src/ggml-zdnn/utils.hpp
index 1111111..2222222 100644
--- a/ggml/src/ggml-zdnn/utils.hpp
+++ b/ggml/src/ggml-zdnn/utils.hpp
@@ -10,6 +10,11 @@ void ggml_zdnn_create_tensor(zdnn_tensor_desc & pre_tfm_desc,
                       const int64_t           * ne,
                       const zdnn_data_layouts   layout);
 
+// Dequantize a quantized weight tensor to F16 and stickify it.
+// Used by ggml_zdnn_init_tensor for quantized weight tensors.
+void ggml_zdnn_dequant_and_load(ggml_backend_zdnn_buffer * buffer,
+                                const ggml_tensor        * tensor);
+
 void ggml_zdnn_load_tensor(zdnn_ztensor & ztensor, void * buffer);
 
 void ggml_zdnn_init_tensor(ggml_backend_zdnn_buffer * buffer, const ggml_tensor * tensor);
diff --git a/ggml/src/ggml-zdnn/utils.cpp b/ggml/src/ggml-zdnn/utils.cpp
index 3333333..4444444 100644
--- a/ggml/src/ggml-zdnn/utils.cpp
+++ b/ggml/src/ggml-zdnn/utils.cpp
@@ -1,5 +1,8 @@
 #include "ggml.h"
+#include "ggml-impl.h"
 #include "utils.hpp"
+#include <vector>
+#include <cstring>
 
 zdnn_data_types ggml_zdnn_type_mapping(ggml_type type) {
     switch (type) {
@@ -17,6 +20,38 @@ zdnn_data_types ggml_zdnn_type_mapping(ggml_type type) {
     }
 }
 
+// Dequantize quantized weight tensor to F16, then stickify into ztensor.
+//
+// Called once at model load time for each quantized weight tensor.
+// The resulting ztensor is declared as FP16 so the zAIU can accept it.
+// Per-inference cost is zero — the stickified F16 is reused every forward pass.
+//
+// Memory layout:
+//   tensor->data  : quantized blocks (Q4_K_M, Q8_0, etc.)
+//   f32_buf       : temporary F32 dequant (stack-allocated vector, freed after)
+//   f16_buf       : temporary F16 conversion (freed after stickify)
+//   buffer->ztensor.buffer : stickified FP16, retained for inference
+void ggml_zdnn_dequant_and_load(ggml_backend_zdnn_buffer * buffer,
+                                const ggml_tensor        * tensor) {
+    const int64_t n_elements = ggml_nelements(tensor);
+
+    // Step 1: dequantize to F32 using ggml's own type traits
+    std::vector<float> f32_buf(n_elements);
+    const ggml_type_traits * tt = ggml_get_type_traits(tensor->type);
+    GGML_ASSERT(tt->to_float != nullptr && "quantized type must have to_float trait");
+    tt->to_float(tensor->data, f32_buf.data(), n_elements);
+
+    // Step 2: convert F32 → F16
+    std::vector<ggml_fp16_t> f16_buf(n_elements);
+    for (int64_t i = 0; i < n_elements; i++) {
+        f16_buf[i] = ggml_fp32_to_fp16(f32_buf[i]);
+    }
+
+    // Step 3: init the ztensor descriptor as FP16 (not the original quant type)
+    //         and stickify the F16 data into it
+    zdnn_init_pre_transformed_desc(
+        ZDNN_2D, FP16, &buffer->pre_tfm_desc,
+        tensor->ne[1], tensor->ne[0]);
+    ZDNN_CHECK(zdnn_generate_transformed_desc(&buffer->pre_tfm_desc, &buffer->tfm_desc));
+    ZDNN_CHECK(zdnn_init_ztensor_with_malloc(&buffer->pre_tfm_desc, &buffer->tfm_desc, &buffer->ztensor));
+    ZDNN_CHECK(zdnn_transform_ztensor(&buffer->ztensor, f16_buf.data()));
+    // f32_buf and f16_buf are freed here (end of scope)
+}
+
 void ggml_zdnn_create_tensor(zdnn_tensor_desc  & pre_tfm_desc,
                              zdnn_tensor_desc  & tfm_desc,
                              zdnn_ztensor      & ztensor,
diff --git a/ggml/src/ggml-zdnn/ggml-zdnn.cpp b/ggml/src/ggml-zdnn/ggml-zdnn.cpp
index 5555555..6666666 100644
--- a/ggml/src/ggml-zdnn/ggml-zdnn.cpp
+++ b/ggml/src/ggml-zdnn/ggml-zdnn.cpp
@@ -78,18 +78,33 @@ static bool ggml_zdnn_supports_op(const ggml_backend_zdnn_device_context * ctx_
         case GGML_OP_MUL_MAT:
             {
                 const ggml_tensor * weights = op->src[0];
                 const ggml_tensor * inputs  = op->src[1];
 
                 const int64_t ne10 = inputs->ne[0];
                 const int64_t ne0  = op->ne[0];
                 const int64_t ne1  = op->ne[1];
 
                 const int64_t max_batch = ctx_dev->max_size;
 
                 if (!ggml_is_matrix(weights) || !ggml_is_matrix(inputs) ||
                     !ggml_is_contiguous(weights) || !ggml_is_contiguous(inputs) ||
                     weights->view_src != nullptr || inputs->view_src != nullptr ||
                     ne0 > max_batch || ne1 > max_batch || ne10 > max_batch) {
                         return false;
                 }
 
-                switch (weights->type) {
-                    case GGML_TYPE_F32:
-                    case GGML_TYPE_F16:
-                    case GGML_TYPE_BF16:
-                        return true;
-                    default:
-                        return false;
+                // Accept F32/F16/BF16 directly.
+                // Accept any quantized type that ggml can dequantize to F32
+                // (i.e. has a to_float trait). These will be dequantized to
+                // F16 at init_tensor time and dispatched as FP16 to the zAIU.
+                switch (weights->type) {
+                    case GGML_TYPE_F32:
+                    case GGML_TYPE_F16:
+                    case GGML_TYPE_BF16:
+                        return true;
+                    default:
+                        {
+                            const ggml_type_traits * tt =
+                                ggml_get_type_traits(weights->type);
+                            return tt != nullptr && tt->to_float != nullptr;
+                        }
                 }
             } break;
 
@@ -148,15 +163,21 @@ static enum ggml_status ggml_backend_zdnn_buffer_init_tensor(
         case GGML_OP_MUL_MAT:
             {
-                std::unique_ptr<ggml_backend_zdnn_buffer> zdnn_bias_buffer = std::make_unique<ggml_backend_zdnn_buffer>();
-                zdnn_bias_buffer->data = (void *)calloc(tensor->ne[0], ggml_element_size(tensor));
-                zdnn_bias_buffer->size = ggml_element_size(tensor) * tensor->ne[0];
-                snprintf(zdnn_bias_buffer->name, GGML_MAX_NAME, "%.*s (bias)",
-                         GGML_MAX_NAME - (int)sizeof(" (bias)"), tensor->name);
-
-                const int64_t bias_dim[GGML_MAX_DIMS] = { 1, 1, 1, tensor->ne[0] };
-                ggml_zdnn_create_tensor(zdnn_bias_buffer->pre_tfm_desc,
-                                        zdnn_bias_buffer->tfm_desc,
-                                        zdnn_bias_buffer->ztensor,
-                                        tensor, bias_dim, ZDNN_1D);
-
-                ggml_zdnn_load_tensor(zdnn_bias_buffer->ztensor, zdnn_bias_buffer->data);
-                zdnn_buffer->extra = zdnn_bias_buffer.get();
-
-                ctx->buffers.push_back(std::move(zdnn_bias_buffer));
-                ctx->n_buffers++;
+                // Bias buffer (zero-filled, required by zdnn_matmul_transpose_op)
+                {
+                    std::unique_ptr<ggml_backend_zdnn_buffer> zdnn_bias_buffer =
+                        std::make_unique<ggml_backend_zdnn_buffer>();
+                    zdnn_bias_buffer->data =
+                        (void *)calloc(tensor->ne[0], sizeof(float));
+                    zdnn_bias_buffer->size = sizeof(float) * tensor->ne[0];
+                    snprintf(zdnn_bias_buffer->name, GGML_MAX_NAME, "%.*s (bias)",
+                             GGML_MAX_NAME - (int)sizeof(" (bias)"),
+                             tensor->name);
+
+                    const int64_t bias_dim[GGML_MAX_DIMS] = { 1, 1, 1, tensor->ne[0] };
+                    ggml_zdnn_create_tensor(zdnn_bias_buffer->pre_tfm_desc,
+                                            zdnn_bias_buffer->tfm_desc,
+                                            zdnn_bias_buffer->ztensor,
+                                            tensor, bias_dim, ZDNN_1D);
+                    ggml_zdnn_load_tensor(zdnn_bias_buffer->ztensor,
+                                          zdnn_bias_buffer->data);
+                    zdnn_buffer->extra = zdnn_bias_buffer.get();
+
+                    ctx->buffers.push_back(std::move(zdnn_bias_buffer));
+                    ctx->n_buffers++;
+                }
             } break;
         default:
             break;
@@ -220,10 +241,18 @@ static void ggml_backend_zdnn_buffer_set_tensor(
     ggml_backend_zdnn_buffer * extra = (ggml_backend_zdnn_buffer *)tensor->extra;
 
+    // For quantized weight tensors that were dequantized at init_tensor time,
+    // the ztensor is already stickified with the F16 dequant data and marked
+    // is_transformed=true. Skip re-stickification — weights never change.
+    if (tensor->buffer && tensor->buffer->usage == GGML_BACKEND_BUFFER_USAGE_WEIGHTS
+        && extra->ztensor.is_transformed) {
+        return;
+    }
+
     // Fixes the LLAMA_SET_ROWS bug
     // see: https://github.com/ggml-org/llama.cpp/issues/15414
     if (tensor->buffer->usage == GGML_BACKEND_BUFFER_USAGE_COMPUTE && extra->ztensor.is_transformed) zdnn_reset_ztensor(&extra->ztensor);
     if (extra->ztensor.is_transformed == false) ggml_zdnn_load_tensor(extra->ztensor, tensor->data);
 
     GGML_UNUSED(buffer);
 }
