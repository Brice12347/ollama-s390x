diff --git a/src/llama-model-loader.cpp b/src/llama-model-loader.cpp
--- a/src/llama-model-loader.cpp
+++ b/src/llama-model-loader.cpp
@@ -1394,6 +1394,30 @@ void llama_model_loader::get_mapping_range(size_t * first, size_t * last, void *
     }
 }
 
+#if defined(__BYTE_ORDER__) && defined(__ORDER_BIG_ENDIAN__) && (__BYTE_ORDER__ == __ORDER_BIG_ENDIAN__)
+static void bswap_tensor_data(struct ggml_tensor * t) {
+    const size_t blk_size = ggml_type_size(t->type);
+    uint8_t * data = (uint8_t *)t->data;
+    const size_t nbytes = ggml_nbytes(t);
+    if (blk_size <= 1) return;
+    if (t->type == GGML_TYPE_Q4_0 || t->type == GGML_TYPE_Q8_0 ||
+        t->type == GGML_TYPE_Q4_1 || t->type == GGML_TYPE_Q5_0 ||
+        t->type == GGML_TYPE_Q5_1) {
+        for (size_t off = 0; off + blk_size <= nbytes; off += blk_size) {
+            uint8_t tmp = data[off]; data[off] = data[off + 1]; data[off + 1] = tmp;
+        }
+        return;
+    }
+    for (size_t i = 0; i + blk_size <= nbytes; i += blk_size) {
+        for (size_t lo = i, hi = i + blk_size - 1; lo < hi; ++lo, --hi) {
+            uint8_t tmp = data[lo]; data[lo] = data[hi]; data[hi] = tmp;
+        }
+    }
+}
+#else
+static void bswap_tensor_data(struct ggml_tensor *) {}
+#endif
+
 void llama_model_loader::load_data_for(struct ggml_tensor * cur) const {
     const auto & w = require_weight(ggml_get_name(cur));
 
@@ -1412,6 +1436,7 @@ void llama_model_loader::load_data_for(struct ggml_tensor * cur) const {
         file->read_raw(cur->data, ggml_nbytes(cur));
     }
 
+    bswap_tensor_data(cur);
     if (check_tensors && !ggml_validate_row_data(cur->type, cur->data, ggml_nbytes(cur))) {
         throw std::runtime_error(format("tensor '%s' has invalid data", ggml_get_name(cur)));
     }
